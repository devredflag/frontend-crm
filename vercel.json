{
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-src 'self' https://embed.waze.com https://*.waze.com https://*.google.com https://*.googleapis.com"
        }
      ]
    }
  ]
}
